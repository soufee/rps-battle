PORT=3001
BASE_URL=http://localhost:3001
# URL для подключения к базе данных (MySQL)
DATABASE_URL=mysql://root:rps_root_sec_password_2026@127.0.0.1:3306/rps_db_v2
# URL для Redis
REDIS_URL=redis://127.0.0.1:6379
# Секреты для JWT (замените на свои случайные строки)
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
# Google OAuth (опционально, если используете авторизацию через Google)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
NODE_ENV=development
# Домен для кук (для локальной разработки можно оставить пустым или localhost)
COOKIE_DOMAIN=localhost

# --- Платформы (заполняются при релизе, см. RELEASE.md) ---
# VK Mini Apps: «Защищённый ключ» из настроек приложения на dev.vk.com
VK_APP_SECRET=
# VK Mini Apps: ID приложения (опционально — дополнительная проверка, что запуск из нашего приложения)
VK_APP_ID=
# Facebook Instant Games: ID и App Secret из настроек приложения на developers.facebook.com
FB_APP_ID=
FB_APP_SECRET=
# Яндекс Игры: секретный ключ из консоли разработчика games.yandex.ru
YANDEX_APP_SECRET=

# --- Только для локальной разработки ---
# Куда редиректить после dev-login, когда клиент запущен отдельным dev-сервером (Expo на :8081).
# На боевом сервере НЕ задавать.
CLIENT_URL=
