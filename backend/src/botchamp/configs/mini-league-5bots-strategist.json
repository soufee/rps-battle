{
  "name": "Мини-лига — 5 ботов разной сложности (со Стратегом)",
  "description": "Круговой чемпионат из 5 ботов разного уровня: Зайчик (лёгкий), Лисёнок и Стратег (средние), Совёнок и Орлёнок (сложные). Каждый играет с каждым дважды — дома (сверху) и в гостях (снизу).",
  "format": "double-round-robin",
  "teams": [
    {
      "id": "rabbit",
      "name": "Зайчик"
    },
    {
      "id": "fox",
      "name": "Лисёнок"
    },
    {
      "id": "strategist",
      "name": "Стратег"
    },
    {
      "id": "owl",
      "name": "Совёнок"
    },
    {
      "id": "orlenok",
      "name": "Орлёнок"
    }
  ],
  "rounds": [
    {
      "round": 1,
      "matches": [
        { "top": "rabbit", "bottom": "fox" },
        { "top": "fox", "bottom": "rabbit" }
      ]
    },
    {
      "round": 2,
      "matches": [
        { "top": "rabbit", "bottom": "strategist" },
        { "top": "strategist", "bottom": "rabbit" }
      ]
    },
    {
      "round": 3,
      "matches": [
        { "top": "rabbit", "bottom": "owl" },
        { "top": "owl", "bottom": "rabbit" }
      ]
    },
    {
      "round": 4,
      "matches": [
        { "top": "rabbit", "bottom": "orlenok" },
        { "top": "orlenok", "bottom": "rabbit" }
      ]
    },
    {
      "round": 5,
      "matches": [
        { "top": "fox", "bottom": "strategist" },
        { "top": "strategist", "bottom": "fox" }
      ]
    },
    {
      "round": 6,
      "matches": [
        { "top": "fox", "bottom": "owl" },
        { "top": "owl", "bottom": "fox" }
      ]
    },
    {
      "round": 7,
      "matches": [
        { "top": "fox", "bottom": "orlenok" },
        { "top": "orlenok", "bottom": "fox" }
      ]
    },
    {
      "round": 8,
      "matches": [
        { "top": "strategist", "bottom": "owl" },
        { "top": "owl", "bottom": "strategist" }
      ]
    },
    {
      "round": 9,
      "matches": [
        { "top": "strategist", "bottom": "orlenok" },
        { "top": "orlenok", "bottom": "strategist" }
      ]
    },
    {
      "round": 10,
      "matches": [
        { "top": "owl", "bottom": "orlenok" },
        { "top": "orlenok", "bottom": "owl" }
      ]
    }
  ]
}
